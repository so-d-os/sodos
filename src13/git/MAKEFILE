# Makefile do git do SODOS, para o MAKE.EXE (so recompila o que mudou).
#   cd \src\git   e depois   make
# Sem o MAKE.EXE, ou se o make falhar: use o BUILD.BAT (compila tudo).
# CC, CFLAGS, SYSINC e SYSLIB ja vem definidos pelo make.

OBJS = git.obj http.obj pack.obj sha1.obj zinf.obj

GIT.EXE: $(OBJS)
	$(CC) $(CFLAGS) -o $@ $(OBJS) $(SYSLIB)TLS.DLL

$(OBJS): git.h
