<Window x:Class="FontesAvancadas.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Fontes Avançadas" Height="760" Width="1100"
        Background="#241820" WindowStartupLocation="CenterScreen"
        FontFamily="Segoe UI" Foreground="White">
  <Window.Resources>
    <Style TargetType="TextBlock">
      <Setter Property="Foreground" Value="White"/>
    </Style>
    <Style TargetType="ListBox">
      <Setter Property="Background" Value="#1C1418"/>
      <Setter Property="Foreground" Value="White"/>
      <Setter Property="BorderThickness" Value="0"/>
    </Style>
    <Style TargetType="ListBoxItem">
      <Setter Property="Padding" Value="12,8"/>
      <Setter Property="Foreground" Value="White"/>
      <Style.Triggers>
        <Trigger Property="IsSelected" Value="True">
          <Setter Property="Background" Value="#6B3A78"/>
        </Trigger>
      </Style.Triggers>
    </Style>
  </Window.Resources>
  <Grid>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="280"/>
      <ColumnDefinition Width="*"/>
    </Grid.ColumnDefinitions>
    <DockPanel Grid.Column="0" Background="#1C1418">
      <TextBlock DockPanel.Dock="Top" Text="Fontes" FontSize="22" Margin="16,16,16,8"/>
      <ListBox x:Name="FontList" DisplayMemberPath="Label" SelectionChanged="FontList_SelectionChanged"/>
    </DockPanel>
    <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto">
      <StackPanel Margin="28,18,28,24">
        <TextBlock x:Name="Crumb" FontSize="20" TextWrapping="Wrap"/>
        <Border Margin="0,16,0,0" BorderBrush="#C84BD0" BorderThickness="0,0,0,2" Background="#1A1216">
          <Grid>
            <TextBox x:Name="Phrase" Background="Transparent" Foreground="White" BorderThickness="0"
                     FontSize="16" Padding="8,8" Text="Exemplo de fonte digitada"
                     TextChanged="Phrase_TextChanged"/>
          </Grid>
        </Border>
        <TextBlock Text="Alterar tamanho da fonte" Margin="0,18,0,6" Foreground="#E4D7DE"/>
        <DockPanel>
          <TextBlock x:Name="SizeLabel" DockPanel.Dock="Right" Margin="12,0,0,0" VerticalAlignment="Center" Text="24 pontos"/>
          <Slider x:Name="SizeSlider" Minimum="8" Maximum="96" Value="24" IsSnapToTickEnabled="True"
                  TickFrequency="1" ValueChanged="SizeSlider_ValueChanged"/>
        </DockPanel>
        <Border Margin="0,16,0,0" Background="#1A1216" Padding="8" MinHeight="80">
          <Image x:Name="Preview" Stretch="None" HorizontalAlignment="Left"/>
        </Border>
        <TextBlock Text="Metadados" FontSize="20" Margin="0,22,0,10"/>
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="170"/>
            <ColumnDefinition Width="*"/>
          </Grid.ColumnDefinitions>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
          </Grid.RowDefinitions>
          <TextBlock Grid.Row="0" Text="Nome" Margin="0,4" Foreground="#E4D7DE"/>
          <TextBlock x:Name="MetaName" Grid.Row="0" Grid.Column="1" Margin="0,4" TextWrapping="Wrap"/>
          <TextBlock Grid.Row="1" Text="Arquivo de fonte" Margin="0,4" Foreground="#E4D7DE"/>
          <TextBlock x:Name="MetaFile" Grid.Row="1" Grid.Column="1" Margin="0,4" TextWrapping="Wrap"/>
          <Button x:Name="Uninstall" Grid.Row="2" Grid.Column="1" HorizontalAlignment="Left" Margin="0,6"
                  Padding="14,4" Content="Desinstalar" Click="Uninstall_Click"
                  Background="#3A2A34" Foreground="White" BorderBrush="#5A4050"/>
          <TextBlock Grid.Row="3" Text="Versão" Margin="0,4" Foreground="#E4D7DE"/>
          <TextBlock x:Name="MetaVersion" Grid.Row="3" Grid.Column="1" Margin="0,4" TextWrapping="Wrap"/>
          <TextBlock Grid.Row="4" Text="Direitos Autorais" Margin="0,4" Foreground="#E4D7DE"/>
          <TextBlock x:Name="MetaCopy" Grid.Row="4" Grid.Column="1" Margin="0,4" TextWrapping="Wrap"/>
          <TextBlock Grid.Row="5" Text="Marcas registradas" Margin="0,4" Foreground="#E4D7DE"/>
          <TextBlock x:Name="MetaTm" Grid.Row="5" Grid.Column="1" Margin="0,4" TextWrapping="Wrap"/>
        </Grid>
        <TextBlock x:Name="Status" Margin="0,16,0,0" Foreground="#C8B4C0" TextWrapping="Wrap"/>
      </StackPanel>
    </ScrollViewer>
  </Grid>
</Window>
