SODOS: sem futex(2) e sem gobject/gio.

O SODOS tem linux/futex.h (para o Firefox), mas syscall() devolve ENOSYS.
Com a propriedade "sodos" no cross file, o glib usa mutex/cond do pthread
e nao configura gobject (libffi) nem gio (resolver DNS), que o QEMU sem
modulos nao usa.

--- a/meson.build
+++ b/meson.build
@@ -894,7 +894,9 @@
 endif
 
 # Check for futex(2)
-if cc.compiles('''#include <linux/futex.h>
+# SODOS: linux/futex.h existe, mas syscall() devolve ENOSYS; usa o pthread.
+sodos_futex = not meson.get_external_property('sodos', false)
+if sodos_futex and cc.compiles('''#include <linux/futex.h>
                #include <sys/syscall.h>
                #include <unistd.h>
                int main (int argc, char ** argv) {
@@ -903,7 +905,7 @@
                }''', name : 'futex(2) system call')
   glib_conf.set('HAVE_FUTEX', 1)
 endif
-if cc.compiles('''#include <linux/futex.h>
+if sodos_futex and cc.compiles('''#include <linux/futex.h>
                #include <sys/syscall.h>
                #include <unistd.h>
                int main (int argc, char ** argv) {
@@ -2387,11 +2389,17 @@
 windows = import('windows')
 subdir('tools')
 subdir('glib')
+# SODOS: so glib/gthread/gmodule; gobject (libffi) e gio (resolver, xdg...)
+# ainda nao sao usados pelo QEMU.
+if not meson.get_external_property('sodos', false)
 subdir('gobject')
+endif
 subdir('gthread')
 subdir('gmodule')
+if not meson.get_external_property('sodos', false)
 subdir('gio')
 subdir('fuzzing')
+endif
 
 # xgettext is optional (on Windows for instance)
 if find_program('xgettext', required : get_option('nls')).found()
