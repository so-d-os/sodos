SODOS: display de texto ui/sodos.c no lugar do curses (-display curses)
e superficie de video em memoria anonima (sem memfd).

diff -ru a/meson.build b/meson.build
--- a/meson.build	2026-11-09 15:24:50.547125127 -0300
+++ b/meson.build	2026-11-09 15:24:56.443034977 -0300
@@ -2437,7 +2437,8 @@
                        blkio.version().version_compare('>=1.4.0'))
 endif
 config_host_data.set('CONFIG_CURL', curl.found())
-config_host_data.set('CONFIG_CURSES', curses.found())
+# SODOS: ui/sodos.c faz o papel do curses (-display curses) sem a biblioteca.
+config_host_data.set('CONFIG_CURSES', curses.found() or meson.get_external_property('sodos', false))
 config_host_data.set('CONFIG_GBM', gbm.found())
