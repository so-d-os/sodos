diff -ru a/ui/qemu-pixman.c b/ui/qemu-pixman.c
--- a/ui/qemu-pixman.c	2026-11-09 15:25:07.766964004 -0300
+++ b/ui/qemu-pixman.c	2026-11-09 15:25:08.177210137 -0300
@@ -277,6 +277,18 @@
 {
 #ifdef WIN32
     return qemu_win32_map_alloc(size, handle, errp);
+#elif defined(__SODOS__)
+    /* SODOS: sem memfd nem mmap compartilhado de arquivo; a superficie so
+     * e usada dentro do processo (ui/sodos.c). qemu_memfd_free faz munmap
+     * e ignora o fd -1. */
+    void *p = mmap(NULL, size, PROT_READ | PROT_WRITE,
+                   MAP_PRIVATE | MAP_ANONYMOUS, -1, 0);
+    if (p == MAP_FAILED) {
+        error_setg_errno(errp, errno, "failed to allocate surface");
+        return NULL;
+    }
+    *handle = -1;
+    return p;
 #else
     return qemu_memfd_alloc(name, size, 0, handle, errp);
 #endif
