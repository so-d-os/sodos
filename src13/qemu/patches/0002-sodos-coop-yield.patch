SODOS: a vCPU do TCG cede a vez periodicamente (threads cooperativas, sem
preempcao no kernel). Sem isto, um guest em laco de espera (in/out na serial
ou o yield() do SeaBIOS, so com saltos diretos) prende o laco principal: o
-serial stdio nao le o teclado e os timers (PIT, disquete) nao disparam.

diff -ru a/accel/tcg/cpu-exec.c b/accel/tcg/cpu-exec.c
--- a/accel/tcg/cpu-exec.c	2026-11-09 15:05:05.605038370 -0300
+++ b/accel/tcg/cpu-exec.c	2026-11-09 15:05:06.005039074 -0300
@@ -402,6 +402,11 @@
 {
     CPUState *cpu = env_cpu(env);
     TranslationBlock *tb;
+
+    /* SODOS: volta ao cpu_exec_loop, que cede a vez. */
+    if (sodos_coop_due()) {
+        return tcg_code_gen_epilogue;
+    }
     vaddr pc;
     uint64_t cs_base;
     uint32_t flags, cflags;
@@ -923,6 +928,12 @@
         return;
     }
 
+#ifdef __SODOS__
+    /* SODOS: saida da contagem de TBs (translator.c), nao do icount. */
+    if (!icount_enabled()) {
+        return;
+    }
+#endif
     /* Instruction counter expired.  */
     assert(icount_enabled());
 #ifndef CONFIG_USER_ONLY
@@ -964,6 +975,9 @@
             uint64_t cs_base;
             uint32_t flags, cflags;
 
+            /* SODOS: fora da BQL, ponto seguro para ceder a vez. */
+            sodos_coop_yield();
+
             cpu_get_tb_cpu_state(cpu_env(cpu), &pc, &cs_base, &flags);
 
