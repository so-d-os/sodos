     }
 
+#ifdef __SODOS__
+    /*
+     * SODOS: sem preempcao, um laco do guest so com saltos diretos (ex.: o
+     * yield() do SeaBIOS esperando IRQ) roda em TBs encadeados para sempre e
+     * o laco principal nunca volta a rodar. Cada TB desconta 64 da parte
+     * baixa do icount_decr (sem uso fora do icount); quando ela passa de
+     * zero, o u32 fica negativo e o TB sai para o cpu_exec_loop, que cede a
+     * vez (sodos_coop_yield): uma saida a cada ~1000 TBs. O store vem antes
+     * do teste para a proxima volta recomecar a contagem.
+     */
+    if (!(cflags & CF_USE_ICOUNT) && !(cflags & CF_NOIRQ)) {
+        tcg_gen_subi_i32(count, count, 64);
+        tcg_gen_st16_i32(count, tcg_env,
+                         offsetof(ArchCPU, parent_obj.neg.icount_decr.u16.low)
+                         - offsetof(ArchCPU, env));
+    }
+#endif
+
     /*
      * Emit the check against icount_decr.u32 to see if we should exit
      * unless we suppress the check with CF_NOIRQ. If we are using
diff -ru a/include/qemu/osdep.h b/include/qemu/osdep.h
--- a/include/qemu/osdep.h	2026-11-09 15:04:59.675039227 -0300
+++ b/include/qemu/osdep.h	2026-11-09 15:05:00.015039045 -0300
@@ -52,6 +52,20 @@
 
 #include "qemu/compiler.h"
 
+/*
+ * SODOS: as threads sao cooperativas e o kernel nao preempta. A vCPU do TCG
+ * cede a vez de tempos em tempos (a cada ~10 ms) para o laco principal ler
+ * o teclado, rodar timers e atender o -serial stdio. Ver firefox/sodos/port/
+ * sodos_thread.c (sodos_coop_due, sodos_coop_yield).
+ */
+#ifdef __SODOS__
+int sodos_coop_due(void);
+void sodos_coop_yield(void);
+#else
+static inline int sodos_coop_due(void) { return 0; }
+static inline void sodos_coop_yield(void) { }
+#endif
+
