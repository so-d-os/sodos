# build/  - saida do meson/ninja (fora do git)
# vendor/ - arvore do QEMU e ferramentas baixadas por setup.sh (fora do git)
build/
vendor/*
!vendor/.gitkeep
*.log
# sodos/sysroot/ - libs portadas (glib, zlib...), geradas por scripts/build-*.sh
sodos/sysroot/*
!sodos/sysroot/lib/
sodos/sysroot/lib/*
!sodos/sysroot/lib/pkgconfig/
sodos/sysroot/lib/pkgconfig/*
!sodos/sysroot/lib/pkgconfig/.gitkeep
