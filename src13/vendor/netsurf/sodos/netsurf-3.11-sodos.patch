+#ifdef __SODOS__
+/* exported interface documented in utils/log.h */
+void nslog_sodos_flush(bool force)
+{
+	static struct timeval last;
+	struct timeval now;
+
+	if (logfile == stderr || logfile == NULL)
+		return;
+	gettimeofday(&now, NULL);
+	if (!force) {
+		long ms;
+		if (!sodos_log_dirty)
+			return;
+		ms = (long)(now.tv_sec - last.tv_sec) * 1000 +
+			(long)(now.tv_usec - last.tv_usec) / 1000;
+		if (ms >= 0 && ms < 2000)
+			return;
+	}
+	fflush(logfile);
+	sodos_log_dirty = false;
+	last = now;
 }
