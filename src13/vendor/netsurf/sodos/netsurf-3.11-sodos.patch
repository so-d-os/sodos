@@ -0,0 +1,210 @@
+/*
+ * Imagens PNG e JPEG no SODOS: decodifica com o img.c da IMG.DLL do SODOS
+ * (ligado no exe), que ja traz inflate, PNG e JPEG baseline/progressivo.
+ *
+ * O primeiro decode acontece quando os dados chegam (data_complete) e o
+ * bitmap vai para o image_cache; se o cache o descartar, sodos_img_convert
+ * decodifica de novo. Imagens com mais de IMG_MAXS pixels de lado chegam
+ * reduzidas, mas o tamanho da pagina usa o tamanho original.
+ *
+ * This file is part of NetSurf, http://www.netsurf-browser.org/
+ * Licensed under the GNU General Public License, version 2.
+ */
+
+#ifdef __SODOS__
+
+#include <stdbool.h>
+#include <stdlib.h>
+#include <string.h>
+
+#include <img.h>
+
+#include "utils/utils.h"
+#include "utils/log.h"
+#include "utils/messages.h"
+#include "netsurf/bitmap.h"
+#include "content/llcache.h"
+#include "content/content.h"
+#include "content/content_protected.h"
+#include "content/content_factory.h"
+#include "desktop/gui_internal.h"
+#include "desktop/bitmap.h"
+
+#include "image/image_cache.h"
+#include "image/sodos_img.h"
+
+/* tamanho original da ultima imagem (img.c) */
+extern int img_src_w, img_src_h;
+
+static nserror sodos_img_create(const content_handler *handler,
+		lwc_string *imime_type, const struct http_parameter *params,
+		llcache_handle *llcache, const char *fallback_charset,
+		bool quirks, struct content **c)
+{
+	struct content *img;
+	nserror error;
+
+	img = calloc(1, sizeof(struct content));
+	if (img == NULL)
+		return NSERROR_NOMEM;
+
+	error = content__init(img, handler, imime_type, params,
+			      llcache, fallback_charset, quirks);
+	if (error != NSERROR_OK) {
+		free(img);
+		return error;
+	}
+	*c = img;
+	return NSERROR_OK;
+}
+
+/* RGBA decodificado -> bitmap do frontend */
+static struct bitmap *sodos_img_to_bitmap(const img_t *im)
+{
+	struct bitmap *bitmap;
+	uint8_t *pixels;
+	size_t rowstride;
+	bool opaque = true;
+	int y;
+	size_t i, n = (size_t)im->w * im->h;
+
+	for (i = 0; i < n; i++) {
+		if (im->rgba[i * 4 + 3] != 0xff) {
+			opaque = false;
+			break;
+		}
+	}
+	bitmap = guit->bitmap->create(im->w, im->h,
+				      opaque ? BITMAP_OPAQUE : BITMAP_NONE);
+	if (bitmap == NULL)
+		return NULL;
+	pixels = guit->bitmap->get_buffer(bitmap);
+	if (pixels == NULL) {
+		guit->bitmap->destroy(bitmap);
+		return NULL;
+	}
+	rowstride = guit->bitmap->get_rowstride(bitmap);
+	for (y = 0; y < im->h; y++)
+		memcpy(pixels + (size_t)y * rowstride,
+		       im->rgba + (size_t)y * im->w * 4, (size_t)im->w * 4);
+	/* img.c entrega R,G,B,A sem alfa pre-multiplicado */
+	bitmap_format_to_client(bitmap, &(bitmap_fmt_t) {
+		.layout = BITMAP_LAYOUT_R8G8B8A8,
+		.pma = false,
+	});
+	guit->bitmap->set_opaque(bitmap, opaque);
+	guit->bitmap->modified(bitmap);
+	return bitmap;
+}
+
+static struct bitmap *sodos_img_convert(struct content *c)
+{
+	const uint8_t *data;
+	size_t size;
+	img_t im;
+	struct bitmap *bitmap;
+
+	data = content__get_source_data(c, &size);
+	if (data == NULL || size == 0 || size > 0x7fffffff)
+		return NULL;
+	if (img_decode(data, (int)size, &im) != 0)
+		return NULL;
+	bitmap = sodos_img_to_bitmap(&im);
+	img_free(&im);
+	return bitmap;
+}
+
+static bool sodos_img_data_complete(struct content *c)
+{
+	union content_msg_data msg_data;
+	const uint8_t *data;
+	size_t size;
+	img_t im;
+	struct bitmap *bitmap;
+	char *title;
+
+	data = content__get_source_data(c, &size);
+	if (data == NULL || size == 0 || size > 0x7fffffff ||
+	    img_decode(data, (int)size, &im) != 0) {
+		NSLOG(netsurf, WARNING, "imagem nao decodificada (%s, %u bytes): %s",
+		      lwc_string_data(c->mime_type), (unsigned)size,
+		      nsurl_access(llcache_handle_get_url(c->llcache)));
+		msg_data.errordata.errorcode = NSERROR_UNKNOWN;
+		msg_data.errordata.errormsg = "Imagem nao suportada";
+		content_broadcast(c, CONTENT_MSG_ERROR, &msg_data);
+		return false;
+	}
+	/* o tamanho na pagina e o da origem, mesmo se o decode reduziu */
+	c->width = img_src_w > 0 ? img_src_w : im.w;
+	c->height = img_src_h > 0 ? img_src_h : im.h;
+	c->size = (size_t)im.w * im.h * 4;
+	bitmap = sodos_img_to_bitmap(&im);
+	img_free(&im);
+	if (bitmap == NULL) {
+		msg_data.errordata.errorcode = NSERROR_NOMEM;
+		msg_data.errordata.errormsg = messages_get("NoMemory");
+		content_broadcast(c, CONTENT_MSG_ERROR, &msg_data);
+		return false;
+	}
+	image_cache_add(c, bitmap, sodos_img_convert);
+
+	title = messages_get_buff("PNGTitle",
+			nsurl_access_leaf(llcache_handle_get_url(c->llcache)),
+			c->width, c->height);
+	if (title != NULL) {
+		content__set_title(c, title);
+		free(title);
+	}
+	content_set_ready(c);
+	content_set_done(c);
+	content_set_status(c, "");
+	return true;
+}
+
+static nserror sodos_img_clone(const struct content *old, struct content **newc)
+{
+	struct content *img;
+	nserror error;
+
+	img = calloc(1, sizeof(struct content));
+	if (img == NULL)
+		return NSERROR_NOMEM;
+	error = content__clone(old, img);
+	if (error != NSERROR_OK) {
+		content_destroy(img);
+		return error;
+	}
+	if ((old->status == CONTENT_STATUS_READY) ||
+	    (old->status == CONTENT_STATUS_DONE)) {
+		if (sodos_img_data_complete(img) == false) {
+			content_destroy(img);
+			return NSERROR_CLONE_FAILED;
+		}
+	}
+	*newc = img;
+	return NSERROR_OK;
+}
+
+static const content_handler sodos_img_content_handler = {
+	.create = sodos_img_create,
+	.data_complete = sodos_img_data_complete,
+	.destroy = image_cache_destroy,
+	.redraw = image_cache_redraw,
+	.clone = sodos_img_clone,
+	.get_internal = image_cache_get_internal,
+	.type = image_cache_content_type,
+	.is_opaque = image_cache_is_opaque,
+	.no_share = false,
+};
+
+static const char *sodos_img_types[] = {
+	"image/png",
+	"image/x-png",
+	"image/jpeg",
+	"image/jpg",
+	"image/pjpeg"
+};
+
+CONTENT_FACTORY_REGISTER_TYPES(sodos_img, sodos_img_types, sodos_img_content_handler);
+
+#endif /* __SODOS__ */
