+/* log em X:\LOG\NETSURF.LOG, X = unidade do exe (o pendrive e U:) */
+#define SODOS_LOG_MAX (256 * 1024)
+static char sodos_log_path[64];
+
+/* poe "-V caminho" no argv para o nslog_init gravar no arquivo */
+static char **sodos_log_args(int *pargc, char **argv)
+{
+	char dir[32], old[64], cwd[64];
+	char drive = 0;
+	struct stat st;
+	char **nv;
+	int i;
+
+	if (*pargc > 1 && argv[1][0] == '-' && (argv[1][1] == 'v' || argv[1][1] == 'V') &&
+	    argv[1][2] == 0)
+		return argv;	/* quem chamou escolheu */
+	if (argv[0] != NULL && argv[0][0] != 0 && argv[0][1] == ':')
+		drive = argv[0][0];
+	else if (getcwd(cwd, sizeof cwd) != NULL && cwd[1] == ':')
+		drive = cwd[0];
+	if (drive == 0)
+		drive = 'U';
+	snprintf(dir, sizeof dir, "%c:\\LOG", drive);
+	snprintf(sodos_log_path, sizeof sodos_log_path, "%s\\NETSURF.LOG", dir);
+	if (stat(dir, &st) != 0)
+		mkdir(dir, 0755);
+	/* grande demais: vira NETSURF.OLD e comeca outro */
+	if (stat(sodos_log_path, &st) == 0 && st.st_size > SODOS_LOG_MAX) {
+		snprintf(old, sizeof old, "%s\\NETSURF.OLD", dir);
+		remove(old);
+		rename(sodos_log_path, old);
+	}
+	nv = calloc((size_t)*pargc + 3, sizeof(char *));
+	if (nv == NULL)
+		return argv;
+	nv[0] = argv[0];
+	nv[1] = "-V";
+	nv[2] = sodos_log_path;
+	for (i = 1; i < *pargc; i++)
+		nv[i + 2] = argv[i];
+	*pargc += 2;
+	return nv;
+}
