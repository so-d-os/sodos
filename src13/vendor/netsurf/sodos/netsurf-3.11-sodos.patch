+	while (*text == ' ')
+		text++;
+	n = strlen(text);
+	while (n > 0 && text[n - 1] == ' ')
+		n--;
+	if (strstr(text, "://") != NULL || strncmp(text, "about:", 6) == 0 ||
+	    strncmp(text, "file:", 5) == 0 || strncmp(text, "data:", 5) == 0 ||
+	    strncmp(text, "resource:", 9) == 0 || strncmp(text, "javascript:", 11) == 0)
+		return nsurl_create(text, url);
