+void
+fbtk_set_progress(fbtk_widget_t *widget, int permille)
+{
+	if ((widget == NULL) || (widget->type != FB_WIDGET_TYPE_TEXT))
+		return;
+	if (permille > 1000)
+		permille = 1000;
+	if (permille < 0)
+		permille = 0;
+	if (widget->u.text.progress == permille)
+		return;
+	widget->u.text.progress = permille;
+	fbtk_request_redraw(widget);
+}
