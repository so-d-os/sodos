# mozconfig/firefox-sodos.mozconfig
#
# Opcoes do browser (libxul) no SODOS, LP64/SOX2. Usado por
# sodos/scripts/build-browser64.sh; a arvore precisa dos patches 0001 a 0005.
#
# So entram opcoes que o configure aceita com o toolkit cairo-sodos: as que
# dependem de GTK (--disable-dbus, --disable-necko-wifi...) nao existem nele.

ac_add_options --target=x86_64-sodos
ac_add_options --enable-application=browser
ac_add_options --enable-default-toolkit=cairo-sodos

# Runtime e alocador: o SODOS nao tem jemalloc/mmap de arquivo.
ac_add_options --disable-jemalloc
ac_add_options --disable-crashreporter
ac_add_options --disable-updater
ac_add_options --disable-tests

# Sem sandbox e sem o que o primeiro build nao precisa.
ac_add_options --disable-sandbox
ac_add_options --disable-accessibility
ac_add_options --disable-parental-controls
ac_add_options --disable-webrtc
ac_add_options --disable-audio-backends
ac_add_options --disable-webspeech
ac_add_options --disable-synth-speechd
ac_add_options --disable-printing
ac_add_options --without-wasm-sandboxed-libraries

ac_add_options --enable-optimize
ac_add_options --disable-debug
ac_add_options --disable-debug-symbols
