no SODOS grava o PNG.

--- a/browser/components/shell/HeadlessShell.sys.mjs
+++ b/browser/components/shell/HeadlessShell.sys.mjs
@@ -89,13 +89,20 @@
 
     let doc = windowlessBrowser.document;
     let browser = doc.createXULElement("browser");
-    browser.setAttribute("remote", "true");
+    // Sem processos de conteudo (SODOS, MOZ_FORCE_DISABLE_E10S) a pagina roda
+    // no processo principal; um browser remoto esperaria um filho para sempre.
+    let e10s = Services.appinfo.browserTabsRemoteAutostart;
+    if (e10s) {
+      browser.setAttribute("remote", "true");
+    }
     browser.setAttribute("type", "content");
     browser.style.width = `${contentWidth}px`;
     browser.style.minWidth = `${contentWidth}px`;
     browser.style.height = `${contentHeight}px`;
     browser.style.minHeight = `${contentHeight}px`;
-    browser.setAttribute("maychangeremoteness", "true");
+    if (e10s) {
+      browser.setAttribute("maychangeremoteness", "true");
+    }
     // Suppress initial about:blank so it can't race any explicit load below.
     browser.setAttribute("nodefaultsrc", "true");
     doc.documentElement.appendChild(browser);
