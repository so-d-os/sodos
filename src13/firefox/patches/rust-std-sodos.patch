diff -ruN a/std/src/sys/alloc/sodos.rs b/std/src/sys/alloc/sodos.rs
--- a/std/src/sys/alloc/sodos.rs	1969-12-31 21:00:00.000000000 -0300
+++ b/std/src/sys/alloc/sodos.rs	2026-11-04 23:00:04.918395594 -0300
@@ -0,0 +1,57 @@
+//! Alocador do SODOS sobre o malloc da LIBCX64, que devolve 16-alinhado.
+//! Alinhamentos maiores guardam o ponteiro original antes do bloco.
+use crate::alloc::{GlobalAlloc, Layout, System};
+use crate::ptr;
+
+const MIN_ALIGN: usize = 16;
+
+unsafe extern "C" {
+    fn malloc(size: usize) -> *mut u8;
+    fn free(p: *mut u8);
+    fn realloc(p: *mut u8, size: usize) -> *mut u8;
+}
+
+#[stable(feature = "alloc_system_type", since = "1.28.0")]
+unsafe impl GlobalAlloc for System {
+    #[inline]
+    unsafe fn alloc(&self, layout: Layout) -> *mut u8 {
+        unsafe {
+            if layout.align() <= MIN_ALIGN {
+                return malloc(layout.size());
+            }
+            let Some(total) = layout.size().checked_add(layout.align()) else {
+                return ptr::null_mut();
+            };
+            let raw = malloc(total);
+            if raw.is_null() {
+                return raw;
+            }
+            let addr = (raw.addr() + layout.align()) & !(layout.align() - 1);
+            let p = raw.with_addr(addr);
+            p.cast::<*mut u8>().sub(1).write_unaligned(raw);
+            p
+        }
+    }
+
+    #[inline]
+    unsafe fn dealloc(&self, p: *mut u8, layout: Layout) {
+        unsafe {
+            if layout.align() <= MIN_ALIGN {
+                free(p);
+            } else {
+                free(p.cast::<*mut u8>().sub(1).read_unaligned());
+            }
+        }
+    }
+
+    #[inline]
+    unsafe fn realloc(&self, p: *mut u8, layout: Layout, new_size: usize) -> *mut u8 {
+        unsafe {
+            if layout.align() <= MIN_ALIGN {
+                realloc(p, new_size)
+            } else {
+                super::realloc_fallback(self, p, layout, new_size)
+            }
+        }
+    }
+}
