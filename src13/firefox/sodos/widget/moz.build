# -*- Mode: python; indent-tabs-mode: nil; tab-width: 40 -*-
# widget/sodos: backend do Gecko no SODOS. Copiado para a arvore do Firefox por
# sodos/scripts/build-browser64.sh.
#
# As janelas sao HeadlessWidget (widget/headless): o Gecko desenha em memoria.
# SodosWindow.cpp liga a primeira janela de topo ao k_gui_* do SODOS.

with Files("**"):
    BUG_COMPONENT = ("Core", "Widget")

SOURCES += [
    "GfxInfo.cpp",
    "MediaKeysEventSourceFactory.cpp",
    "nsAppShell.cpp",
    "nsBidiKeyboard.cpp",
    "nsLookAndFeel.cpp",
    "nsNativeThemeSodos.cpp",
    "nsUserIdleServiceSodos.cpp",
    "nsWidgetFactory.cpp",
    "nsWindowSodos.cpp",
    "SodosWindow.cpp",
]

XPCOM_MANIFESTS += [
    "components.conf",
]

include("/ipc/chromium/chromium-config.mozbuild")

FINAL_LIBRARY = "xul"

LOCAL_INCLUDES += [
    "/layout/base",
    "/toolkit/xre",
    "/widget",
    "/widget/headless",
    "/xpcom/components",
]
