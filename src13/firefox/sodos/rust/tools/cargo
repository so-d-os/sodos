#!/usr/bin/env python3
"""cargo wrapper: mapeia --target x86_64-sodos para o JSON.

Com o std ja instalado no sysroot (sodos/scripts/patch-rust-std.sh), nao usa
build-std: assim o cargo do Firefox nao mistura as crates do std com o vendor
dele. SODOS_BUILD_STD=1 forca o build-std (e como o script gera o std).
"""
import glob
import os
import subprocess
import sys

HERE = os.path.dirname(os.path.abspath(__file__))
JSON = os.path.normpath(os.path.join(HERE, "..", "custom", "x86_64-sodos.json"))
RUSTC = os.path.join(HERE, "rustc")
RUSTUP = os.path.expanduser("~/.cargo/bin/rustup")

args = sys.argv[1:]
out = []
i = 0
while i < len(args):
    a = args[i]
    if a == "--target" and i + 1 < len(args) and args[i + 1] == "x86_64-sodos":
        out += ["--target", JSON]
        i += 2
        continue
    if a == "--target=x86_64-sodos":
        out.append("--target=" + JSON)
        i += 1
        continue
    out.append(a)
    i += 1

env = dict(os.environ)
env["RUSTC"] = RUSTC
sysroot = subprocess.check_output([RUSTUP, "run", "nightly", "rustc", "--print", "sysroot"],
                                  text=True).strip()
installed = glob.glob(os.path.join(sysroot, "lib", "rustlib", "x86_64-sodos", "lib", "libstd-*.rlib"))
# -Z globais precisam vir antes do subcomando (build/check/...).
cmd = [RUSTUP, "run", "nightly", "cargo", "-Zjson-target-spec"]
if os.environ.get("SODOS_BUILD_STD") or not installed:
    cmd.append("-Zbuild-std=std,panic_abort")
sys.exit(subprocess.call(cmd + out, env=env))
