#!/bin/sh
# sodos-cc64 - gcc -m64 (SOX2/LP64) com os headers do SODOS.
D=$(cd "$(dirname "$0")" && pwd)
C=$D/../../c_compiler
# Mesmo criterio do sodos-cxxlib64: -fPIC (ou SODOS_PIC=1) troca large/nao-PIC
# por PIC no modelo small, que tambem entra em bibliotecas .so.
MODEL="-mcmodel=large -fno-pic -fno-pie"
[ -n "$SODOS_PIC" ] && MODEL="-fPIC -ftls-model=initial-exec"
for a in "$@"; do
  case "$a" in
    -fPIC|-fpic|-fPIE|-fpie) MODEL="-ftls-model=initial-exec" ;;
    -fno-pic|-fno-PIC|-fno-pie|-fno-PIE) MODEL="-mcmodel=large -fno-pic -fno-pie" ;;
  esac
done
exec gcc -m64 -march=x86-64 -msse2 -mno-red-zone $MODEL -mstackrealign \
  -ffreestanding -fno-stack-protector \
  -fno-asynchronous-unwind-tables -fno-jump-tables \
  -fno-tree-loop-distribute-patterns -nostdinc \
  -isystem "$D/include" -isystem "$C/include" \
  -isystem "$(gcc -print-file-name=include)" \
  -D__SODOS__ "$@"
