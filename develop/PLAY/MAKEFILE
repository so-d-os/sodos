# Makefile do PLAY do SODOS, para o MAKE.EXE (so recompila o que mudou).
#   cd \develop\play   e depois   make
# Sem o MAKE.EXE, ou se o make falhar: use o BUILD.BAT (compila tudo).
# CC, CFLAGS, SYSINC e SYSLIB ja vem definidos pelo make.

OBJS = play.obj

PLAY.EXE: $(OBJS)
	$(CC) $(CFLAGS) -o $@ $(OBJS) $(SYSLIB)GUI.DLL $(SYSLIB)IMG.DLL
