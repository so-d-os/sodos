# Makefile do AGENT2 do SODOS, para o MAKE.EXE (so recompila o que mudou).
#   cd \develop\agent2   e depois   make
# Sem o MAKE.EXE, ou se o make falhar: use o BUILD.BAT (compila tudo).
# CC, CFLAGS, SYSINC e SYSLIB ja vem definidos pelo make.

OBJS = agent2.obj

AGENT2.EXE: $(OBJS)
	$(CC) $(CFLAGS) -o $@ $(OBJS)

# O agent2.c inclui o ai_client.c (fonte unica, como no AIPANEL).
$(OBJS): ai_client.c
