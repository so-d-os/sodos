# Artefatos de build do compilador/port (nao versionar)
src13/c_compiler/build/*
src13/c_compiler/out/
src13/fonts/FontesAvancadas/bin/
src13/fonts/FontesAvancadas/obj/

# mkvid.py e' fonte e vive em build/ (mantem versionado)
!src13/c_compiler/build/mkvid.py

# Scripts e saidas temporarias de depuracao
.tmp_*
src13/.tmp_*
src13/*/.tmp_*

# Midia grande (video de exemplo do player) - fora do git
src13/content/*.mp4

# Arquivo de lixo de uma sessao antiga (nome U+F03A, 815 bytes)


# Versao do kernel gerada no build (tools/mkversion.sh). O numero da build e a
# contagem de commits (o mesmo em todo checkout); o BUILDLOC so guarda o +K dos
# kernels de teste com mudancas nao commitadas, desta maquina.
src13/kernel/version.h
src13/kernel/BUILDLOC

# develop/: so fonte vai para o git. AGENT.CFG tem a chave da API; os .json
# sao estado local dos programas (janela, dumps); .obj e .EXE saem do build.
develop/**/[Aa][Gg][Ee][Nn][Tt].[Cc][Ff][Gg]
develop/**/*.[Jj][Ss][Oo][Nn]
develop/**/*.[Oo][Bb][Jj]
develop/**/*.[Ee][Xx][Ee]
develop/**/__pycache__/
# PLAY/linux: ffmpeg e yt-dlp do Linux (binarios grandes, baixe de novo).
develop/PLAY/linux/
# Sessoes gravadas do agente e temporarios.
develop/**/*.[Ss][Ee][Ss]
develop/**/*.[Tt][Mm][Pp]
# CON e nome reservado no DOS/Windows: o arquivo nao abre la.
develop/**/[Cc][Oo][Nn]

# Estado local do app do Claude (gravado na pasta onde ele roda) e
# configuracao pessoal do Claude Code.
/.claude/settings.local.json
/ccd-ids.json
/dump-organizations.json
/plan-usage-history.json
/queue-purge-owed
/remote-control-state.json
window-state.json
